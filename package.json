{
  "name": "awesome-agentic-engineering",
  "version": "0.8.0",
  "description": "Production-ready patterns, templates, evals, and scorecards for shipping AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentic-score": "./bin/agentic-score.js",
    "agentic-badge": "./bin/agentic-badge.js",
    "agentic-validate-fixtures": "./bin/validate-prompt-injection-fixtures.js",
    "agentic-validate-results": "./bin/validate-eval-results.js"
  },
  "files": [
    "assets",
    "action",
    "action.yml",
    "bin",
    "docs",
    "evals",
    "examples",
    "launch",
    "profiles",
    "schema",
    "scripts",
    "social",
    "templates",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "check:stars": "node bin/star-watch.js",
    "check:stars:text": "node bin/star-watch.js --text",
    "badge": "node bin/agentic-badge.js examples/coding-agent.card.json",
    "score": "node bin/agentic-score.js examples/coding-agent.card.json",
    "score:operations": "node bin/agentic-score.js examples/operations-agent.card.json",
    "validate:fixtures": "node bin/validate-prompt-injection-fixtures.js evals/prompt-injection/fixtures.jsonl",
    "validate:results": "node bin/validate-eval-results.js examples/eval-results/pass.json --fixtures evals/prompt-injection/fixtures.jsonl && node bin/validate-eval-results.js examples/eval-results/fail.json --fixtures evals/prompt-injection/fixtures.jsonl",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "ai-agent",
    "agentic-ai",
    "llm",
    "evals",
    "mcp",
    "production",
    "scorecard"
  ],
  "engines": {
    "node": ">=20"
  }
}
